{
  "name": "rohan-core-lite",
  "version": "1.0.0",
  "description": "Rohan Core Lite - Real Estate Management (Quotation, Cost Sheet, Booking & Collections)",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node-dev --project server/tsconfig.json --respawn --transpile-only server/src/index.ts",
    "dev:client": "vite client",
    "build": "vite build client --outDir ../dist",
    "preview": "vite preview client",
    "test": "jest --config server/jest.config.js --runInBand --detectOpenHandles",
    "seed": "ts-node --project server/tsconfig.json server/src/db/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.63.0",
    "pg": "^8.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "postcss": "^8.5.32",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2",
    "vite": "^8.3.5"
  }
}
